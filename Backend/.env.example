# Copy to .env and fill in. .env is gitignored — never commit real credentials.

PORT=5000
NODE_ENV=development

# AssemblyAI — required for POST /api/transcribe
ASSEMBLY_AI_API_KEY=

# Google Gemini — required by services/geminiSpeechService.js
GEMINI_API_KEY=

# Cloudinary — cloud name has a default; key/secret are needed for uploads
CLOUDINARY_CLOUD_NAME=dxjb5lepy
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin — only needed if there is no Backend/serviceAccountKey.json.
# Wrap the private key in quotes and keep the literal \n escapes.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=
FIREBASE_STORAGE_BUCKET=
